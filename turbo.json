{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "cache": false,
      "outputs": []
    },
    "//#format:root": {
      "cache": false,
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": [
        "^build"
      ]
    },
    "demo:saga": {
      "cache": false,
      "dependsOn": [
        "^build"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "EVENT_BUS",
        "NATS_URL",
        "CATALOG_URL",
        "CATALOG_INTERNAL_TOKEN",
        "ORDERS_SERVICE_URL",
        "DEMO_PRODUCT_ID"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "outputs": []
    }
  }
}
