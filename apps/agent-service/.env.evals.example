# Copiar a .env.evals y completar las claves con el .env local de la raíz.
LANGSMITH_API_KEY=
OPENAI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=mercadoya-agent

# El MCP de Compose requiere publicar el puerto de loopback como indica el README.
MCP_URL=http://localhost:8080/mcp
MCP_INTERNAL_TOKEN=

AGENT_MODEL=gpt-6-luna
AGENT_REASONING_EFFORT=low
AGENT_CLASSIFIER_MODEL=clef
AGENT_EVAL_JUDGE_MODEL=gpt-6-luna

# JWT vigente del comprador de demo; vence en 5 minutos.
AGENT_EVAL_BUYER_JWT=
# UUID de un producto real de demo con al menos dos unidades de stock.
AGENT_EVAL_PRODUCT_ID=
# UUID de un pedido pending perteneciente al mismo comprador.
AGENT_EVAL_ORDER_ID=
