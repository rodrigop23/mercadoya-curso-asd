    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "aws-cdk": "2.1143.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
