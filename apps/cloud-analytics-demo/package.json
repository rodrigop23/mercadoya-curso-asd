{
  "name": "@mercadoya/cloud-analytics-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bootstrap": "cdk bootstrap",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "demo:glue": "node scripts/run-glue-demo.mjs",
    "demo:athena": "node scripts/run-athena-demo.mjs",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "aws-cdk-lib": "2.270.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "aws-cdk": "2.1143.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
