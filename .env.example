DATABASE_URL=postgresql://mercadoya:mercadoya_local@localhost:5432/mercadoya
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:8000
# Polar es el default. Solo la demo histórica opta por PAYMENT_PROVIDER=simulator.
PAYMENT_PROVIDER=polar
POLAR_SERVER=sandbox
# Token de organización: products:write, organizations:write y checkouts:write/read.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# Catalog sincroniza productos y establece PEN en Polar. No se configura un mapa JSON.
POLAR_WEB_ORIGIN=http://localhost:5173
PAYMENT_MODE=succeed
EVENT_BUS=nats
NATS_URL=nats://localhost:4222
ORDERS_SERVICE_URL=http://localhost:3002
# Compatibilidad explícita; no es el default de aplicación.
INVENTORY_V1_URL=http://localhost:3003
# Default de aplicación, incluido /api/inventory/*.
INVENTORY_V2_URL=http://localhost:3005
IDENTITY_URL=http://localhost:3006
GATEWAY_URL=http://localhost:8000
# Stock interno, no usar Kong como origen.
CATALOG_URL=http://localhost:3007
CATALOG_INTERNAL_TOKEN=replace-with-a-random-shared-secret
NOTIFICATIONS_INVOKE_TOKEN=replace-with-a-random-invoke-secret
NOTIFICATIONS_BRIDGE_URL=http://localhost:3004
NOTIFICATIONS_BRIDGE_PORT=3004
# Set only after deploying Lambda; leave empty for the local handler.
NOTIFICATIONS_FUNCTION_URL=

# Empty EMAIL_MODE selects resend when a key exists, otherwise stub.
EMAIL_MODE=
RESEND_API_KEY=
# Use an address from your verified Resend domain.
RESEND_FROM=
# Recipient for class orders, including buyerId=null from demo:saga.
DEMO_NOTIFY_EMAIL=

JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=mercadoya-services
IDENTITY_JWKS_URL=http://localhost:3006/api/auth/jwks
