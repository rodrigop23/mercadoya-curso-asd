DATABASE_URL=postgresql://mercadoya:mercadoya_local@localhost:5432/mercadoya
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:8000
# Polar es el único proveedor de pagos.
ORDER_PENDING_TTL_MINUTES=15
ORDER_EXPIRY_GRACE_SECONDS=120
PAYMENT_PROVIDER=polar
POLAR_SERVER=sandbox
POLAR_GET_TIMEOUT_MS=5000
# Token de organización: products:write, organizations:write y checkouts:write/read.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# Catalog sincroniza productos y establece PEN en Polar. No se configura un mapa JSON.
POLAR_WEB_ORIGIN=http://localhost:5173
EVENT_BUS=nats
NATS_URL=nats://localhost:4222
ORDERS_SERVICE_URL=http://localhost:3002
IDENTITY_URL=http://localhost:3006
GATEWAY_URL=http://localhost:8000
# Stock interno, no usar Kong como origen.
CATALOG_URL=http://localhost:3007
CATALOG_INTERNAL_TOKEN=replace-with-a-random-shared-secret
NOTIFICATIONS_INVOKE_TOKEN=replace-with-a-random-invoke-secret
NOTIFICATIONS_BRIDGE_URL=http://localhost:3004
NOTIFICATIONS_BRIDGE_PORT=3004
# Set only after deploying Lambda; leave empty for the local handler.
NOTIFICATIONS_FUNCTION_URL=

# Empty EMAIL_MODE selects resend when a key exists, otherwise stub.
EMAIL_MODE=
RESEND_API_KEY=
# Use an address from your verified Resend domain.
RESEND_FROM=
# Recipient for class orders.
DEMO_NOTIFY_EMAIL=

JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=mercadoya-services
IDENTITY_JWKS_URL=http://localhost:3006/api/auth/jwks

# Perfil opcional agent. La imagen requiere una LANGSMITH_API_KEY válida y salida
# a internet al arrancar en modo lite local. Producción requiere licencia.
OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mercadoya-agent
LANGSMITH_TRACING=true
AGENT_MODEL=gpt-6-luna
AGENT_REASONING_EFFORT=low
# openai | echo | scripted, los dos últimos no llaman al modelo.
AGENT_MODEL_PROVIDER=openai
AGENT_MODERATION=off
AGENT_MAX_INPUT_CHARS=2000
# false permite depurar/evaluar con PII redactada. Activa true para omitir todo
# el contenido en entornos que prohíban enviarlo a LangSmith, incluso redactado.
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
# Generar con openssl rand -hex 32. Compartido solo por el agente y MCP.
MCP_INTERNAL_TOKEN=
AGENT_DB_PASSWORD=agent_server_local
# Si el password contiene caracteres reservados de URI, define AGENT_DATABASE_URI
# con el password codificado. El init recibe AGENT_DB_PASSWORD sin codificar.
