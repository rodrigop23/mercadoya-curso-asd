{
  "name": "mercadoya",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=@mercadoya/web --filter=@mercadoya/mf-catalog",
    "demo:infra": "docker compose up -d postgres nats && pnpm --filter @mercadoya/catalog-service db:migrate && pnpm --filter @mercadoya/identity-service db:migrate && mkdir -p apps/api/uploads && LOCAL_UID=$(id -u) LOCAL_GID=$(id -g) docker compose up -d --build",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format format:root",
    "format:root": "oxfmt package.json turbo.json .oxlintrc.json .oxfmtrc.json",
    "typecheck": "turbo run typecheck",
    "demo:saga": "turbo run demo:saga --filter @mercadoya/orders-service",
    "test": "turbo run test",
    "openapi:generate": "turbo run openapi:generate --filter=@mercadoya/contracts",
    "openapi:check": "turbo run openapi:check --filter=@mercadoya/contracts"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "turbo": "^2.11.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "packageManager": "pnpm@11.8.0"
}
