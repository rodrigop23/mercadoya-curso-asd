{
  "name": "@mercadoya/contracts",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "test": "node --test test/*.test.mjs",
    "openapi:generate": "node scripts/openapi.mjs",
    "openapi:check": "node scripts/openapi.mjs --check && redocly lint --config redocly.yaml"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@redocly/cli": "2.0.0",
    "yaml": "2.8.1"
  }
}
